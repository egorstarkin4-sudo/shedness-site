# ==============================================================================
# Shedness Launcher — Environment Variables Template
# Copy to .env.local (Next.js) and configure Supabase Secrets via CLI.
# NEVER commit real secrets to git.
# ==============================================================================

# --- Public Client Variables (Safe to expose in browser) ---
NEXT_PUBLIC_SITE_URL=https://shedness.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY

# --- Server-Only Next.js Variables (NEVER prefix with NEXT_PUBLIC_) ---
# Used only in server middleware/components if needed; keep empty if unused.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ==============================================================================
# Supabase Edge Functions Secrets (Set via `supabase secrets set ...`)
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# ALLOWED_ORIGINS=https://shedness.example.com,http://localhost:3000
# TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY
# LICENSE_HMAC_SECRET=<64-hex-char random secret: openssl rand -hex 32>
# LICENSE_KEY_PEPPER=<64-hex-char random secret: openssl rand -hex 32>
# TOTP_ENCRYPTION_KEY=<64-hex-char 32-byte AES-256 key: openssl rand -hex 32>
# ADMIN_SESSION_SECRET=<64-hex-char random secret: openssl rand -hex 32>
#
# Optional Upstash Redis for distributed edge rate-limiting (falls back to Postgres RPC if omitted):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
